/* To learn more about Typescript configuration file: https://www.typescriptlang.org/docs/handbook/tsconfig-json.html. */
/* To learn more about Angular compiler options: https://angular.dev/reference/configs/angular-compiler-options. */
{
	"compileOnSave": false,
	"compilerOptions": {
		"jsx": "react-jsx",
		"noImplicitOverride": true,
		"noPropertyAccessFromIndexSignature": true,
		"noImplicitReturns": true,
		"noFallthroughCasesInSwitch": true,
		"skipLibCheck": true,
		"isolatedModules": true,
		"experimentalDecorators": true,
		"importHelpers": true,
		"target": "ES2022",
		"module": "preserve",
		"paths": {
			"@quenetiq/downloader": ["./projects/quenetiq/downloader/src/public-api.ts"],
			"@quenetiq/core": ["./projects/quenetiq/core/src/public-api.ts"],
			"@quenetiq/subscriptions": ["./projects/quenetiq/subscriptions/src/public-api.ts"],
			"@quenetiq/subscriptions/angular": ["./projects/quenetiq/subscriptions/src/angular.ts"],
			"@quenetiq/file-upload": ["./projects/quenetiq/file-upload/src/public-api.ts"],
			"@quenetiq/dev-server": ["./projects/quenetiq/dev-server/src/public-api.ts"],
			"@quenetiq/debugging": ["./projects/quenetiq/debugging/src/public-api.ts"],
			"@quenetiq/cache": ["./projects/quenetiq/cache/src/public-api.ts"],
			"@quenetiq/cache/angular": ["./projects/quenetiq/cache/src/angular.ts"],
			"@quenetiq/fragments": ["./projects/quenetiq/fragments/src/public-api.ts"],
			"@quenetiq/pagination": ["./projects/quenetiq/pagination/src/public-api.ts"],
			"@quenetiq/ssr": ["./projects/quenetiq/ssr/src/public-api.ts"],
			"@quenetiq/persisted-queries": ["./projects/quenetiq/persisted-queries/src/public-api.ts"],
			"@quenetiq/middlewares": ["./projects/quenetiq/middlewares/src/public-api.ts"],
			"@quenetiq/middlewares/angular": ["./projects/quenetiq/middlewares/src/angular.ts"],
			"@quenetiq/observables": ["./projects/quenetiq/observables/src/public-api.ts"],
			"@quenetiq/testing": ["./projects/quenetiq/testing/src/public-api.ts"],
			"@quenetiq/client": ["./projects/quenetiq/client/src/public-api.ts"],
			"@quenetiq/opentelemetry": ["./projects/quenetiq/opentelemetry/src/public-api.ts"],
			"@quenetiq/opentelemetry/angular": ["./projects/quenetiq/opentelemetry/src/angular/index.ts"],
			"@quenetiq/react": ["./projects/quenetiq/react/src/public-api.ts"],
			"@quenetiq/vue": ["./projects/quenetiq/vue/src/public-api.ts"]
		}
	},
	"angularCompilerOptions": {
		"enableI18nLegacyMessageIdFormat": false,
		"strictInjectionParameters": true,
		"strictInputAccessModifiers": true
	},
	"files": [],
	"references": [
		{
			"path": "./tsconfig.app.json"
		}
	]
}
